{
  "manifest_version": 3,
  "name": "AvastLuxe True Shield",
  "short_name": "TrueShield",
  "version": "1.0.0",
  "description": "Real-life guard: instant + live verdicts (scam, dead, parked, genuine) on every link you tap, type or see. Background worker always on.",
  "minimum_chrome_version": "109",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "True Shield — check any link" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications", "webNavigation", "tabs", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["true-engine.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": []
}
